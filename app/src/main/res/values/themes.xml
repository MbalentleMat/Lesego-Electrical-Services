<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main app theme - dark purple/black matching website -->
    <style name="Theme.LesesoElectrical" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_purple</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/bottom_nav_bg</item>
        <item name="android:textColorPrimary">@color/text_light</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorError">@color/error_red</item>
        <!-- EditText box style -->
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.LesesoElectrical.Splash" parent="Theme.LesesoElectrical">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/background_dark</item>
    </style>

    <!-- Auth screens (login/register) -->
    <style name="Theme.LesesoElectrical.Auth" parent="Theme.LesesoElectrical">
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- Material Button - primary purple -->
    <style name="Widget.LesesoElectrical.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Outlined Button -->
    <style name="Widget.LesesoElectrical.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/accent_purple</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Google Sign-In Button -->
    <style name="Widget.LesesoElectrical.Button.Google" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/text_muted</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/surface_dark</item>
    </style>

    <!-- Card style -->
    <style name="Widget.LesesoElectrical.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Input field style -->
    <style name="Widget.LesesoElectrical.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/accent_purple</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="boxBackgroundColor">@color/input_bg</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.LesesoElectrical.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/primary_dark</item>
        <item name="titleTextColor">@color/text_light</item>
        <item name="subtitleTextColor">@color/accent_purple</item>
    </style>

    <!-- Chip style -->
    <style name="Widget.LesesoElectrical.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_dark</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_light</item>

    </style>
</resources>
