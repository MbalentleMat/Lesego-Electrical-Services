<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:strokeColor="#7C3AED" app:strokeWidth="1dp" app:cardElevation="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/tvAdminBookingService" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvAdminBookingCustomer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#374151" android:layout_marginBottom="6dp"/>
        <TextView android:id="@+id/tvAdminBookingReference" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#4B5563" android:layout_marginBottom="6dp"/>
        <TextView android:id="@+id/tvAdminBookingDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#374151" android:layout_marginBottom="10dp"/>
        <TextView android:id="@+id/tvAdminBookingStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="UPDATE BOOKING STATUS" android:textStyle="bold" android:textSize="13sp" android:textColor="#111827" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerAdminBookingStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#F3F4F6" android:spinnerMode="dropdown" android:dropDownWidth="match_parent" android:layout_marginBottom="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnUpdateBookingStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Update Booking Status" android:textColor="#FFFFFF" android:textAllCaps="false" app:backgroundTint="#1D4ED8" app:cornerRadius="10dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="14dp" android:background="#E5E7EB"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ELECTRICIAN ASSIGNMENT" android:textStyle="bold" android:textSize="13sp" android:textColor="#111827" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvAssignedContractor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#374151" android:layout_marginBottom="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select an available electrician" android:textSize="13sp" android:textColor="#4B5563" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerAssignContractor" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#F3F4F6" android:spinnerMode="dropdown" android:dropDownWidth="match_parent" android:layout_marginBottom="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Only electricians with saved, compatible schedules can be assigned." android:textColor="#6B7280" android:textSize="12sp" android:layout_marginBottom="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAssignContractor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Assign Electrician" android:textAllCaps="false" android:textColor="#FFFFFF" app:backgroundTint="#15803D" app:cornerRadius="10dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>