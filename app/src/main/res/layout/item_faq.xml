<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:layout_marginBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
        <TextView android:id="@+id/tvQuestion" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text_light" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvExpandIcon" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="+" android:textColor="@color/accent_purple"
            android:textSize="20sp" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvAnswer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/text_muted"
        android:textSize="13sp" android:lineSpacingMultiplier="1.3"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp"
        android:visibility="gone"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
</LinearLayout>
