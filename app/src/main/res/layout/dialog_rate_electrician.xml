<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/tvReviewContractor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rate your electrician" android:textSize="16sp" android:layout_marginBottom="12dp"/>
    <RatingBar android:id="@+id/ratingElectrician" android:layout_width="wrap_content" android:layout_height="wrap_content" android:numStars="5" android:stepSize="1" android:rating="0" android:layout_gravity="center_horizontal"/>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Your review (optional)">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etElectricianReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="3" android:maxLines="5" android:inputType="textCapSentences|textMultiLine" android:maxLength="1000"/>
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>