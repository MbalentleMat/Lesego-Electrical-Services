<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My Notifications" android:textColor="@color/text_light" android:textStyle="bold" android:textSize="24sp" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnRefreshNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh Notifications"/>
        <TextView android:id="@+id/tvNotificationsMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:textColor="@color/text_muted" android:text="Loading notifications..."/>
        <LinearLayout android:id="@+id/notificationsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>